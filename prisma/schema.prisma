generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ChatSession {
  id         String    @id @default(uuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  expires_at DateTime?

  title  String?
  status String  @default("active") // active, closed, archived

  userId String

  messages ChatMessage[]

  agentId String? //Optional for entire session
  agent   Agent?  @relation(fields: [agentId], references: [id])

  token_count Int?   @default(0) // Total token count for the session
  cost        Float? @default(0) // Total cost for the session
}

model ChatMessage {
  id String @id @default(uuid())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  content Json
  sender  String // If agentId and sender is same then message sent by the agent else user and fetched by sessionId
  type    String @default("text") // text, image, code

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade) //Cascade deletes the Message if seesion is deleted

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id])

  @@index([sessionId])
}

enum LLMModelSetupStatus {
  NOT_INITIALIZED
  PENDING // Task queued
  IN_PROGRESS
  PAUSE // Potentially for pausing downloads
  RETRYING
  FAILED
  ROLLING_BACK // If attempting to undo a failed install
  CANCELED // User requested cancellation
  NEEDS_ATTENTION //Requires Human Input
  COMPLETED
}

model LLMModelSetupProcess {
  id         String              @id @default(uuid())
  model      String
  provider   String?
  status     LLMModelSetupStatus @default(NOT_INITIALIZED)
  created_at DateTime            @default(now())
  updated_at DateTime            @updatedAt
  message    String? // Store error messages or status details
}

model LLMModel {
  id            String  @id @default(uuid())
  name          String  @unique
  modelName     String
  version       String?
  description   String
  defaultPrompt String

  temperatureMin     Float? @default(0.0)
  temperatureMax     Float? @default(1.0)
  temperatureDefault Float? @default(0.7)

  top_pMin     Float? @default(0.0)
  top_pMax     Float? @default(1.0)
  top_pDefault Float? @default(0.9)

  top_kMin     Int? @default(0)
  top_kMax     Int? @default(100)
  top_kDefault Int? @default(0)

  max_tokensMin     Int? @default(1)
  max_tokensMax     Int? @default(4096)
  max_tokensDefault Int? @default(256)

  presence_penaltyMin     Float? @default(-2.0)
  presence_penaltyMax     Float? @default(2.0)
  presence_penaltyDefault Float? @default(0.0)

  frequency_penaltyMin     Float? @default(-2.0)
  frequency_penaltyMax     Float? @default(2.0)
  frequency_penaltyDefault Float? @default(0.0)

  repeat_penaltyMin     Float? @default(1.0)
  repeat_penaltyMax     Float? @default(2.0)
  repeat_penaltyDefault Float? @default(1.0)

  stop_sequences Json? // Store as a JSON array of strings

  usageCount Int      @default(0)
  agents     Agent[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Agent {
  id   String @id @default(uuid())
  name String

  llmModelId  String
  llmModel    LLMModel @relation(fields: [llmModelId], references: [id])
  description String?
  prompt      String?

  temperature       Float?
  top_p             Float?
  top_k             Int?
  max_tokens        Int?
  presence_penalty  Float?
  frequency_penalty Float?
  repeat_penalty    Float?

  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  ChatSession ChatSession[]
  ChatMessage ChatMessage[]
  AgentTool   AgentTool[]
}

model ToolConfig {
  id                    String        @id @default(uuid())
  name                  String
  description           String
  input_schema          Json
  output_schema         Json
  execution_type        ExecutionType
  execution_details     Json
  code                  String?       @db.Text // For JAVASCRIPT_FUNCTION or PYTHON_FUNCTION
  auth_type             AuthType
  auth_details          Json?
  is_safe               Boolean       @default(false)
  requires_confirmation Boolean       @default(false)
  usage_count           Int           @default(0)
  last_used             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  agents                AgentTool[]
}

model AgentTool {
  agentId      String
  agent        Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  toolConfigId String
  toolConfig   ToolConfig @relation(fields: [toolConfigId], references: [id], onDelete: Cascade)

  @@id([agentId, toolConfigId])
}

enum ExecutionType {
  REST_API
  PYTHON_FUNCTION
  JAVASCRIPT_FUNCTION
  CUSTOM
}

enum AuthType {
  NONE
  API_KEY
  OAUTH2
  CUSTOM
}

model ScheduledTask {
  id          String   @id @default(uuid())
  name        String
  cron        String
  task        String
  active      Boolean  @default(true)
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cron])
}
